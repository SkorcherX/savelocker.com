---
interface Props {
  title?: string;
  tone?: 'note' | 'warn';
}

const { title, tone = 'note' } = Astro.props;
const accent = tone === 'warn' ? 'border-l-accent-amber' : 'border-l-accent-green';
const titleColor = tone === 'warn' ? 'text-accent-amber-lt' : 'text-accent-green';
---

<div class={`rounded-r border border-l-[3px] border-border bg-bg-card px-5 py-4 ${accent}`}>
  {title && <div class={`text-[14px] font-semibold ${titleColor}`}>{title}</div>}
  <div class:list={['prose-sl text-[14px] leading-relaxed', title && 'mt-2']}>
    <slot />
  </div>
</div>
