---
// Hand-built rather than generated: the arrows carry the whole argument (the pull happens BEFORE
// the game starts), and an image generator cannot be trusted with text or direction.
---

<div class="overflow-x-auto">
  <svg
    viewBox="0 0 900 310"
    role="img"
    aria-labelledby="syncdiag-title syncdiag-desc"
    class="mx-auto block h-auto w-full min-w-[620px] max-w-4xl"
  >
    <title id="syncdiag-title">How SaveLocker moves a save</title>
    <desc id="syncdiag-desc">
      Your PC and your Steam Deck each connect to a locker you host. The locker sends the newest
      save to a machine before the game launches, and each machine sends its save back to the
      locker after you quit.
    </desc>

    <defs>
      <marker id="arrow-out" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 0 L 10 5 L 0 10 z" fill="#8b9aaa" />
      </marker>
      <marker id="arrow-in" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 0 L 10 5 L 0 10 z" fill="#129271" />
      </marker>
    </defs>

    <!-- pull: locker -> each machine, before launch -->
    <text x="450" y="34" text-anchor="middle" fill="#8b9aaa" font-family="Inter, sans-serif" font-size="12" font-weight="600" letter-spacing="1.4">PULL — BEFORE THE GAME STARTS</text>
    <path d="M 395 112 C 340 52, 200 52, 132 104" fill="none" stroke="#8b9aaa" stroke-width="1.75" marker-end="url(#arrow-out)" />
    <path d="M 505 112 C 560 52, 700 52, 768 104" fill="none" stroke="#8b9aaa" stroke-width="1.75" marker-end="url(#arrow-out)" />

    <!-- push: each machine -> locker, after exit -->
    <path d="M 132 196 C 200 250, 340 250, 395 192" fill="none" stroke="#129271" stroke-width="1.75" marker-end="url(#arrow-in)" />
    <path d="M 768 196 C 700 250, 560 250, 505 192" fill="none" stroke="#129271" stroke-width="1.75" marker-end="url(#arrow-in)" />
    <text x="450" y="284" text-anchor="middle" fill="#129271" font-family="Inter, sans-serif" font-size="12" font-weight="600" letter-spacing="1.4">PUSH — AFTER YOU QUIT</text>

    <!-- Your PC -->
    <rect x="30" y="110" width="150" height="86" rx="6" fill="#1E252A" stroke="#494949" stroke-width="1.5" />
    <rect x="82" y="130" width="46" height="30" rx="3" fill="none" stroke="#8b9aaa" stroke-width="1.75" />
    <path d="M 98 166 h 14 M 105 160 v 6" stroke="#8b9aaa" stroke-width="1.75" stroke-linecap="round" />
    <text x="105" y="184" text-anchor="middle" fill="#ECEFF1" font-family="Inter, sans-serif" font-size="13" font-weight="600">Your PC</text>

    <!-- The locker -->
    <rect x="375" y="104" width="150" height="98" rx="6" fill="#1E252A" stroke="#129271" stroke-width="1.75" />
    <rect x="432" y="124" width="36" height="34" rx="4" fill="none" stroke="#129271" stroke-width="1.75" />
    <circle cx="450" cy="141" r="6" fill="none" stroke="#129271" stroke-width="1.75" />
    <path d="M 450 147 v 5" stroke="#129271" stroke-width="1.75" stroke-linecap="round" />
    <text x="450" y="171" text-anchor="middle" fill="#ECEFF1" font-family="Inter, sans-serif" font-size="13" font-weight="600">Your locker</text>
    <text x="450" y="187" text-anchor="middle" fill="#8b9aaa" font-family="'JetBrains Mono', monospace" font-size="10.5">NAS · unRAID · mini PC</text>

    <!-- Steam Deck -->
    <rect x="720" y="110" width="150" height="86" rx="6" fill="#1E252A" stroke="#494949" stroke-width="1.5" />
    <rect x="770" y="130" width="50" height="30" rx="5" fill="none" stroke="#8b9aaa" stroke-width="1.75" />
    <circle cx="778" cy="145" r="3.5" fill="#8b9aaa" />
    <circle cx="812" cy="145" r="3.5" fill="#8b9aaa" />
    <text x="795" y="184" text-anchor="middle" fill="#ECEFF1" font-family="Inter, sans-serif" font-size="13" font-weight="600">Steam Deck</text>
  </svg>
</div>
