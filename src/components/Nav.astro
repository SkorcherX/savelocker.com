---
const links = [
  { href: '/#how', label: 'How it works' },
  { href: '/#features', label: 'Features' },
  { href: '/#compare', label: 'Compare' },
  { href: '/faq', label: 'FAQ' },
];
const GITHUB = 'https://github.com/SkorcherX/SaveLocker';
---

<header class="sticky top-0 z-40 border-b border-border/60 bg-bg-global/90 backdrop-blur-sm">
  <nav class="mx-auto flex h-14 max-w-6xl items-center gap-6 px-5" aria-label="Main">
    <a href="/" class="flex shrink-0 items-center gap-2.5">
      <img src="/img/logo.png" alt="" width="26" height="26" class="h-[26px] w-[26px]" />
      <span class="text-[15px] font-bold tracking-tight">
        Save<span class="text-accent-green">Locker</span>
      </span>
    </a>

    <div class="hidden flex-1 items-center gap-6 md:flex">
      {
        links.map((l) => (
          <a
            href={l.href}
            class="text-[13px] text-text-secondary transition-colors hover:text-text-primary"
          >
            {l.label}
          </a>
        ))
      }
    </div>

    <div class="ml-auto flex items-center gap-4 md:ml-0">
      {/* Below md the link row is hidden, which would strand the FAQ — keep it reachable. */}
      <a
        href="/faq"
        class="text-[13px] text-text-secondary transition-colors hover:text-text-primary md:hidden"
        >FAQ</a
      >
      <a
        href={GITHUB}
        class="hidden text-[13px] text-text-secondary transition-colors hover:text-text-primary sm:inline"
        >Source on GitHub</a
      >
      <a
        href="/start"
        class="rounded bg-accent-green px-3.5 py-1.5 text-[13px] font-semibold text-white transition-opacity hover:opacity-85"
        >Get started</a
      >
    </div>
  </nav>
</header>
